---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="cs336-docs">
  <aside class="cs336-sidebar-left" aria-label="Series navigation">
    {% include cs336_sidebar.liquid %}
  </aside>

  <article class="cs336-content post">
    <header class="cs336-page-header">
      <p class="cs336-eyebrow">Notes · CS 336</p>
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="cs336-page-desc">{{ page.description }}</p>
      {% endif %}
    </header>

    <div id="markdown-content" class="post-content">
      {{ content }}
    </div>

    {% if page.prev_page or page.next_page %}
      <nav class="cs336-pager" aria-label="Page navigation">
        {% if page.prev_page %}
          <a class="cs336-pager-prev" href="{{ page.prev_page.path | relative_url }}">
            <span>Previous</span>
            <strong>{{ page.prev_page.title }}</strong>
          </a>
        {% else %}
          <span></span>
        {% endif %}
        {% if page.next_page %}
          <a class="cs336-pager-next" href="{{ page.next_page.path | relative_url }}">
            <span>Next</span>
            <strong>{{ page.next_page.title }}</strong>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    {% if site.giscus and page.giscus_comments %}
      {% include giscus.liquid %}
    {% endif %}
  </article>

  <aside class="cs336-sidebar-right" aria-label="On this page">
    <p class="cs336-toc-heading">On this page</p>
    <nav id="toc-sidebar" class="sticky-top"></nav>
  </aside>
</div>
