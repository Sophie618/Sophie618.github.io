<div
  id="giscus_thread"
  {% if page.layout == 'post' %}
    style="max-width: {{ site.max_width }}; margin: 0 auto;"
  {% endif %}
>
  {% if page.layout == 'post' %}
    <br>
  {% endif %}

  {% if site.giscus.repo and site.giscus.repo_id and site.giscus.category_id %}
    <script defer src="{{ '/assets/js/giscus-setup.js' | relative_url }}"></script>
    <noscript>
      Please enable JavaScript to view the
      <a href="http://giscus.app/?ref_noscript">comments powered by giscus.</a>
    </noscript>
  {% elsif site.giscus.repo and site.giscus.repo_id %}
    <div class="comments-pending" role="note">
      <h2>Comments</h2>
      <p>Comments will open here once GitHub Discussions is enabled for this repository.</p>
    </div>
  {% else %}
    <div class="comments-pending" role="note">
      <h2>Comments</h2>
      <p>Comments are not configured yet.</p>
    </div>
  {% endif %}
</div>
